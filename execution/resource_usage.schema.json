{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explainbench.local/schemas/execution-trace-resource-usage-v1.json",
  "title": "ExplainBench execution.trace resource usage",
  "oneOf": [
    { "$ref": "#/$defs/runRecord" },
    { "$ref": "#/$defs/instanceRecord" }
  ],
  "$defs": {
    "nullableDateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableNonnegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "code", "message", "exception_type"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["workload", "measurement"]
        },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "exception_type": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "failure_kind",
        "failed_phase",
        "evaluation_completed",
        "resolved"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["completed", "partial", "failed", "interrupted"]
        },
        "failure_kind": {
          "type": ["string", "null"],
          "enum": [
            null,
            "timeout",
            "oom_killed",
            "patch_error",
            "docker_error",
            "tracer_error",
            "evaluation_error",
            "cancelled",
            "unknown_error"
          ]
        },
        "failed_phase": { "type": ["string", "null"] },
        "evaluation_completed": { "type": ["boolean", "null"] },
        "resolved": { "type": ["boolean", "null"] }
      }
    },
    "measurementStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "missing_metrics"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "partial", "unavailable"]
        },
        "missing_metrics": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_seconds",
        "attempted_samples",
        "successful_samples",
        "failed_samples",
        "first_sample_at",
        "last_sample_at"
      ],
      "properties": {
        "interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attempted_samples": { "type": "integer", "minimum": 0 },
        "successful_samples": { "type": "integer", "minimum": 0 },
        "failed_samples": { "type": "integer", "minimum": 0 },
        "first_sample_at": { "$ref": "#/$defs/nullableDateTime" },
        "last_sample_at": { "$ref": "#/$defs/nullableDateTime" }
      }
    },
    "resourceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "cpu_usage_ns",
        "cpu_percent_mean",
        "cpu_percent_peak",
        "memory_usage_sampled_peak_bytes",
        "memory_working_set_sampled_peak_bytes",
        "block_io_read_bytes",
        "block_io_write_bytes",
        "pids_sampled_peak",
        "sample_count"
      ],
      "properties": {
        "wall_time_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "cpu_usage_ns": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "cpu_percent_mean": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "cpu_percent_peak": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "memory_usage_sampled_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "memory_working_set_sampled_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "block_io_read_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "block_io_write_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "pids_sampled_peak": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "sample_count": { "type": "integer", "minimum": 0 }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "started_at", "ended_at", "metrics"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["completed", "timed_out", "failed", "interrupted", "skipped"]
        },
        "started_at": { "$ref": "#/$defs/nullableDateTime" },
        "ended_at": { "$ref": "#/$defs/nullableDateTime" },
        "metrics": { "$ref": "#/$defs/resourceMetrics" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "file_count",
        "total_bytes",
        "largest_file_bytes",
        "event_count"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "partial", "missing"]
        },
        "file_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "largest_file_bytes": { "type": "integer", "minimum": 0 },
        "event_count": { "$ref": "#/$defs/nullableNonnegativeInteger" }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "total_bytes",
        "available_start_bytes",
        "available_min_bytes",
        "available_end_bytes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["trace_output", "docker_data_root"]
        },
        "path": { "type": "string" },
        "total_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "available_start_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "available_min_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "available_end_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explainbench_git_revision",
        "explainbench_git_dirty",
        "python_version",
        "swebench_version",
        "docker_sdk_version"
      ],
      "properties": {
        "explainbench_git_revision": { "type": ["string", "null"] },
        "explainbench_git_dirty": { "type": ["boolean", "null"] },
        "python_version": { "type": "string" },
        "swebench_version": { "type": "string" },
        "docker_sdk_version": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "kernel_version",
        "architecture",
        "cpu_model",
        "logical_cpu_count",
        "memory_total_bytes",
        "swap_total_bytes",
        "storage_type",
        "docker_server_version",
        "docker_api_version",
        "docker_storage_driver",
        "docker_data_root",
        "cgroup_version"
      ],
      "properties": {
        "operating_system": { "type": "string" },
        "kernel_version": { "type": "string" },
        "architecture": { "type": "string" },
        "cpu_model": { "type": ["string", "null"] },
        "logical_cpu_count": { "type": "integer", "minimum": 1 },
        "memory_total_bytes": { "type": "integer", "minimum": 0 },
        "swap_total_bytes": { "type": "integer", "minimum": 0 },
        "storage_type": { "type": ["string", "null"] },
        "docker_server_version": { "type": "string" },
        "docker_api_version": { "type": "string" },
        "docker_storage_driver": { "type": "string" },
        "docker_data_root": { "type": "string" },
        "cgroup_version": {
          "type": "string",
          "enum": ["1", "2", "unknown"]
        }
      }
    },
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_used_sampled_peak_bytes",
        "memory_available_sampled_min_bytes",
        "swap_used_sampled_peak_bytes",
        "cpu_percent_mean",
        "cpu_percent_peak",
        "load1_sampled_peak",
        "active_trace_containers_peak",
        "aggregate_container_working_set_sampled_peak_bytes",
        "trace_artifact_total_bytes",
        "instances_completed",
        "instances_partial",
        "instances_failed",
        "instances_interrupted",
        "instances_timed_out",
        "throughput_completed_per_hour"
      ],
      "properties": {
        "memory_used_sampled_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "memory_available_sampled_min_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "swap_used_sampled_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "cpu_percent_mean": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "cpu_percent_peak": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "load1_sampled_peak": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "active_trace_containers_peak": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "aggregate_container_working_set_sampled_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "trace_artifact_total_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInteger"
        },
        "instances_completed": { "type": "integer", "minimum": 0 },
        "instances_partial": { "type": "integer", "minimum": 0 },
        "instances_failed": { "type": "integer", "minimum": 0 },
        "instances_interrupted": { "type": "integer", "minimum": 0 },
        "instances_timed_out": { "type": "integer", "minimum": 0 },
        "throughput_completed_per_hour": {
          "$ref": "#/$defs/nullableNonnegativeNumber"
        }
      }
    },
    "runRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "generated_at",
        "run",
        "software",
        "host",
        "sampling",
        "measurement",
        "summary",
        "filesystems",
        "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "const": "run" },
        "generated_at": { "type": "string", "format": "date-time" },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "agent",
            "instance_selection",
            "resolved_instance_count",
            "resolved_instance_ids_sha256",
            "max_workers",
            "timeout_seconds",
            "cache_state",
            "started_at",
            "ended_at",
            "wall_time_seconds",
            "state"
          ],
          "properties": {
            "run_id": { "type": "string" },
            "agent": { "type": "string" },
            "instance_selection": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resolved_instance_count": { "type": "integer", "minimum": 0 },
            "resolved_instance_ids_sha256": { "type": "string" },
            "max_workers": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
            "cache_state": {
              "type": "string",
              "enum": ["cold", "warm", "mixed", "unknown"]
            },
            "started_at": { "type": "string", "format": "date-time" },
            "ended_at": { "$ref": "#/$defs/nullableDateTime" },
            "wall_time_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
            "state": {
              "type": "string",
              "enum": ["completed", "partial", "failed", "interrupted"]
            }
          }
        },
        "software": { "$ref": "#/$defs/software" },
        "host": { "$ref": "#/$defs/host" },
        "sampling": { "$ref": "#/$defs/sampling" },
        "measurement": { "$ref": "#/$defs/measurementStatus" },
        "summary": { "$ref": "#/$defs/runSummary" },
        "filesystems": {
          "type": "array",
          "items": { "$ref": "#/$defs/filesystem" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    },
    "instanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "generated_at",
        "run_id",
        "agent",
        "instance_id",
        "container",
        "started_at",
        "ended_at",
        "wall_time_seconds",
        "outcome",
        "measurement",
        "sampling",
        "container_metrics",
        "phases",
        "artifacts",
        "errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "const": "instance" },
        "generated_at": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "agent": { "type": "string" },
        "instance_id": { "type": "string" },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image",
            "memory_limit_bytes",
            "nano_cpus",
            "pids_limit",
            "lifetime_peak_memory_bytes",
            "lifetime_peak_memory_source",
            "oom_killed"
          ],
          "properties": {
            "id": { "type": ["string", "null"] },
            "image": { "type": ["string", "null"] },
            "memory_limit_bytes": { "$ref": "#/$defs/nullableNonnegativeInteger" },
            "nano_cpus": { "$ref": "#/$defs/nullableNonnegativeInteger" },
            "pids_limit": { "$ref": "#/$defs/nullableNonnegativeInteger" },
            "lifetime_peak_memory_bytes": {
              "$ref": "#/$defs/nullableNonnegativeInteger"
            },
            "lifetime_peak_memory_source": {
              "type": ["string", "null"],
              "enum": [null, "docker_max_usage", "cgroup_memory_peak"]
            },
            "oom_killed": { "type": ["boolean", "null"] }
          }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "$ref": "#/$defs/nullableDateTime" },
        "wall_time_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "measurement": { "$ref": "#/$defs/measurementStatus" },
        "sampling": { "$ref": "#/$defs/sampling" },
        "container_metrics": { "$ref": "#/$defs/resourceMetrics" },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container_setup": { "$ref": "#/$defs/phase" },
            "tracer_archive_copy": { "$ref": "#/$defs/phase" },
            "patch_prepare_apply": { "$ref": "#/$defs/phase" },
            "buggy_prepare": { "$ref": "#/$defs/phase" },
            "buggy_exec": { "$ref": "#/$defs/phase" },
            "buggy_copy_out": { "$ref": "#/$defs/phase" },
            "patched_prepare": { "$ref": "#/$defs/phase" },
            "patched_exec": { "$ref": "#/$defs/phase" },
            "patched_copy_out": { "$ref": "#/$defs/phase" },
            "grading": { "$ref": "#/$defs/phase" },
            "cleanup": { "$ref": "#/$defs/phase" }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buggy", "patched"],
          "properties": {
            "buggy": { "$ref": "#/$defs/artifact" },
            "patched": { "$ref": "#/$defs/artifact" }
          }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    }
  }
}
